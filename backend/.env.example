# ===== Bản mẫu biến môi trường backend =====
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env lên git.

# Khóa bí mật Django (tự sinh chuỗi ngẫu nhiên dài)
SECRET_KEY=django-insecure-doi-thanh-chuoi-ngau-nhien

# True khi chạy local, False khi deploy production
DEBUG=True

# ----- DATABASE -----
# Cách 1 (LOCAL): khai báo từng biến rời
DB_NAME=smartenglish_db
DB_USER=smartenglish_user
DB_PASSWORD=smart123
DB_HOST=localhost
DB_PORT=5432

# Cách 2 (PRODUCTION - Neon/Render): chỉ cần 1 biến duy nhất, sẽ ưu tiên dùng biến này.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ----- AI -----
# Lấy khóa miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=dan_khoa_gemini_vao_day

# ----- Chỉ dùng khi deploy -----
# ALLOWED_HOSTS=smartenglish-backend.onrender.com
# FRONTEND_ORIGINS=https://smartenglish.vercel.app
